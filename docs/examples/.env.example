# Copy to the repository root as .env, then replace placeholders locally.
# Never commit the filled-in .env file.
JIRA_DOMAIN=example.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-with-your-token

# Optional: bypass automatic cloud/workspace discovery when you know the IDs.
# JIRA_CLOUD_ID=replace-with-cloud-id
# JIRA_WORKSPACE_ID=replace-with-workspace-id

# Optional: bounds on AQL results returned to the host.
# JSM_FETCH_ALL_MAX_OBJECTS=500
# JSM_MAX_RESULT_BYTES=1048576

# Optional: schema cache lifetime in seconds (default 600), and whether to
# build the schema summary in the background at startup (default true).
# JSM_SCHEMA_CACHE_TTL=600
# JSM_SCHEMA_PREFETCH=true

# Optional: leave the create/update/delete tools unregistered.
# JSM_READ_ONLY=true
# Optional: limit writes to these object schema IDs (unset or * = every schema).
# JSM_WRITE_SCHEMA_IDS=101,102

# Only search_assets needs a translation provider and its corresponding extra.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-your-provider-key
# LLM_MODEL=optional-provider-model-id
